<!-- delivery_project/views/delivery_wizard_views.xml -->
<odoo>

    <record id="view_delivery_trip_wizard_form" model="ir.ui.view">
        <field name="name">delivery.trip.wizard.form</field>
        <field name="model">delivery.trip.wizard</field>
        <field name="arch" type="xml">
            <form string="Crear repartiment">
                <sheet>
                    <group>
                        <field name="employee_id"/>
                        <field name="vehicle_id"/>
                        <field name="sender_id"/>
                    </group>
                    <group string="Receptor">
                        <field name="receiver_name"/>
                        <field name="receiver_phone"/>
                        <field name="receiver_address"/>
                    </group>
                    <group string="Detalls">
                        <field name="distance_km"/>
                        <field name="weight_kg"/>
                        <field name="volume_m3"/>
                        <field name="urgency"/>
                    </group>
                </sheet>
                <footer>
                    <button string="Crear"
                            type="object"
                            name="action_create_trip"
                            class="btn-primary"/>
                    <button string="Cancel·lar"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_delivery_trip_wizard" model="ir.actions.act_window">
        <field name="name">Wizard repartiment</field>
        <field name="res_model">delivery.trip.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_delivery_trip_wizard_form"/>
        <field name="target">new</field>
    </record>

    <!-- botó des de llista de repartiments -->
    <record id="view_delivery_trip_tree_inherit_wizard" model="ir.ui.view">
        <field name="name">delivery.trip.tree.wizard.button</field>
        <field name="model">delivery.trip</field>
        <field name="inherit_id" ref="view_delivery_trip_tree"/>
        <field name="arch" type="xml">
            <tree position="inside">
                <button name="%(action_delivery_trip_wizard)d"
                        type="action"
                        string="Nou repartiment simple"/>
            </tree>
        </field>
    </record>

</odoo>